<Window x:Class="LegalHelper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="True" ResizeMode="CanResizeWithGrip"
        MinWidth="380" MinHeight="420" Width="480" Height="560"
        Title="GTA 5 RP Legal Helper">
  <Border Background="#F2111318" CornerRadius="16" BorderBrush="#303541" BorderThickness="1"
          Padding="12" MouseLeftButtonDown="Border_MouseLeftButtonDown">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="44"/>
        <RowDefinition Height="44"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="64"/>
      </Grid.RowDefinitions>

      <DockPanel Grid.Row="0">
        <StackPanel DockPanel.Dock="Left">
          <TextBlock Text="GTA 5 RP Legal Helper" Foreground="White" FontSize="16" FontWeight="Bold"/>
          <TextBlock x:Name="HotkeyHint" Foreground="#8D93A1" FontSize="10" Text="F9 — оверлей"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button Content="📋" Width="32" Height="30" Background="Transparent" Foreground="#BFC4CF"
                  BorderThickness="0" Click="Copy_Click" ToolTip="Копировать ответ" Cursor="Hand"/>
          <Button x:Name="PinBtn" Content="📌" Width="32" Height="30" Background="Transparent" Foreground="#BFC4CF"
                  BorderThickness="0" Click="Pin_Click" ToolTip="Поверх всех окон" Cursor="Hand"/>
          <Button Content="⚙" Width="32" Height="30" Background="Transparent" Foreground="#BFC4CF"
                  BorderThickness="0" Click="SettingsBtn_Click" Cursor="Hand"/>
          <Button Content="×" Width="32" Height="30" FontSize="18" Background="Transparent" Foreground="#BFC4CF"
                  BorderThickness="0" Click="CloseBtn_Click" Cursor="Hand"/>
        </StackPanel>
      </DockPanel>

      <StackPanel Grid.Row="1" Orientation="Horizontal">
        <ComboBox x:Name="ProjectBox" Width="120" Margin="0,0,6,0" SelectionChanged="ProjectBox_Changed">
          <ComboBoxItem Content="GTA5RP" IsSelected="True"/>
          <ComboBoxItem Content="Majestic RP"/>
          <ComboBoxItem Content="Russia Online"/>
        </ComboBox>
        <ComboBox x:Name="ServerBox" Width="150" Margin="0,0,6,0"/>
        <ComboBox x:Name="ModeBox" Width="150">
          <ComboBoxItem Content="Правила сервера" Tag="rules" IsSelected="True"/>
          <ComboBoxItem Content="Законодательная база" Tag="laws"/>
        </ComboBox>
      </StackPanel>

      <Grid Grid.Row="2" Margin="0,8,0,6">
        <ScrollViewer x:Name="AnswerScroll" VerticalScrollBarVisibility="Auto">
          <TextBlock x:Name="Answer" Foreground="#F4F6FA" FontSize="14" TextWrapping="Wrap"
                     Text="Выбери проект → сервер → раздел и задай вопрос. Ответ строится по актуальным страницам официального форума."/>
        </ScrollViewer>
        <Border x:Name="SettingsPanel" Visibility="Collapsed" Background="#EE171A21" CornerRadius="12"
                Padding="14" BorderBrush="#3A4050" BorderThickness="1">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
              <TextBlock Text="Настройки" Foreground="White" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
              <TextBlock Text="Прозрачность" Foreground="#9CA3AF" FontSize="11"/>
              <Slider x:Name="OpacitySlider" Minimum="0.45" Maximum="1" Value="0.94" TickFrequency="0.05"
                      IsSnapToTickEnabled="True" ValueChanged="OpacitySlider_Changed"/>
              <TextBlock x:Name="OpacityLabel" Text="94%" Foreground="#9CA3AF" FontSize="11" Margin="0,0,0,8"/>
              <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <Button Content="− размер" Margin="0,0,6,0" Padding="10,4" Background="#303541" Foreground="White"
                        BorderThickness="0" Click="SizeDown_Click" Cursor="Hand"/>
                <Button Content="+ размер" Margin="0,0,6,0" Padding="10,4" Background="#303541" Foreground="White"
                        BorderThickness="0" Click="SizeUp_Click" Cursor="Hand"/>
                <Button Content="Сброс" Padding="10,4" Background="#303541" Foreground="White"
                        BorderThickness="0" Click="SizeReset_Click" Cursor="Hand"/>
              </StackPanel>
              <CheckBox x:Name="ClickThroughBox" Content="Клик насквозь (окно не ловит мышь)" Foreground="White" Margin="0,0,0,6"/>
              <TextBlock Text="Бинды: клик → клавиша (Esc отмена)" Foreground="#9CA3AF" FontSize="11" Margin="0,6,0,6"/>
              <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="130"/></Grid.ColumnDefinitions>
                <TextBlock Text="Оверлей вкл/выкл" Foreground="White" VerticalAlignment="Center"/>
                <Button x:Name="ToggleBindBtn" Grid.Column="1" Content="F9" Background="#303541" Foreground="#6D5DFB"
                        BorderThickness="0" Click="ToggleBindBtn_Click" Cursor="Hand"/>
              </Grid>
              <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="130"/></Grid.ColumnDefinitions>
                <TextBlock Text="Микрофон" Foreground="White" VerticalAlignment="Center"/>
                <Button x:Name="MicBindBtn" Grid.Column="1" Content="F10" Background="#303541" Foreground="#6D5DFB"
                        BorderThickness="0" Click="MicBindBtn_Click" Cursor="Hand"/>
              </Grid>
              <TextBlock x:Name="BindCaptureHint" Foreground="#F59E0B" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"/>
              <TextBlock Text="История вопросов" Foreground="#9CA3AF" FontSize="11" Margin="0,4,0,4"/>
              <ListBox x:Name="HistoryList" MaxHeight="120" Background="#20242D" Foreground="White" BorderThickness="0"
                       MouseDoubleClick="HistoryList_DoubleClick"/>
              <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <Button Content="Сохранить" Background="#6D5DFB" Foreground="White" BorderThickness="0"
                        Padding="14,6" Click="SaveSettings_Click" Cursor="Hand" Margin="0,0,6,0"/>
                <Button Content="Сброс биндов" Background="#303541" Foreground="White" BorderThickness="0"
                        Padding="14,6" Click="ResetBinds_Click" Cursor="Hand" Margin="0,0,6,0"/>
                <Button Content="Закрыть" Background="Transparent" Foreground="#9CA3AF" BorderThickness="0"
                        Padding="14,6" Click="SettingsBtn_Click" Cursor="Hand"/>
              </StackPanel>
              <TextBlock x:Name="VersionLabel" Foreground="#6B7280" FontSize="10" Margin="0,12,0,0"/>
              <TextBlock x:Name="UpdateLabel" Foreground="#34D399" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
            </StackPanel>
          </ScrollViewer>
        </Border>
      </Grid>

      <TextBlock Grid.Row="3" x:Name="StatusText" Foreground="#6B7280" FontSize="10" Margin="0,0,0,4"/>

      <Grid Grid.Row="4">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="48"/>
        </Grid.ColumnDefinitions>
        <TextBox x:Name="Question" AcceptsReturn="True" VerticalContentAlignment="Center" Padding="10"
                 Background="#20242D" Foreground="White" BorderThickness="0" FontSize="13"
                 KeyDown="Question_KeyDown"/>
        <Button Grid.Column="1" Margin="6,0,0,0" Content="➤" FontSize="16" Background="#6D5DFB"
                Foreground="White" BorderThickness="0" Click="SendBtn_Click" Cursor="Hand" x:Name="SendBtn"/>
      </Grid>
    </Grid>
  </Border>
</Window>
