<Window x:Class="LegalHelper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="True"
        ResizeMode="CanResizeWithGrip"
        MinWidth="720"
        MinHeight="560"
        Width="940"
        Height="700"
        Title="GTA5RP Legal Helper">

    <Window.Resources>

        <!-- =========================
             COLORS
             ========================= -->

        <SolidColorBrush x:Key="Bg" Color="#0B0D12"/>
        <SolidColorBrush x:Key="Panel" Color="#11141B"/>
        <SolidColorBrush x:Key="Panel2" Color="#151923"/>
        <SolidColorBrush x:Key="Panel3" Color="#191E29"/>
        <SolidColorBrush x:Key="Border" Color="#252B38"/>
        <SolidColorBrush x:Key="BorderHover" Color="#343C4D"/>

        <SolidColorBrush x:Key="Text" Color="#F5F7FA"/>
        <SolidColorBrush x:Key="Text2" Color="#A8AFBC"/>
        <SolidColorBrush x:Key="Text3" Color="#687180"/>

        <SolidColorBrush x:Key="Accent" Color="#7467FF"/>
        <SolidColorBrush x:Key="Accent2" Color="#8B80FF"/>
        <SolidColorBrush x:Key="Green" Color="#35D49A"/>
        <SolidColorBrush x:Key="Red" Color="#FF5C70"/>
        <SolidColorBrush x:Key="Yellow" Color="#F4B95E"/>

        <!-- =========================
             MAIN BUTTON
             ========================= -->

        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource Text2}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="10">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background"
                                        Value="#202531"/>
                                <Setter Property="Foreground"
                                        Value="{StaticResource Text}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background"
                                        Value="#292F3D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- =========================
             QUICK ACTION
             ========================= -->

        <Style x:Key="QuickActionButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Panel2}"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background"
                                        Value="#191E29"/>
                                <Setter Property="BorderBrush"
                                        Value="#3A4253"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background"
                                        Value="#202633"/>
                            </Trigger>

                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- =========================
             CHIP
             ========================= -->

        <Style x:Key="ChipButton" TargetType="Button">
            <Setter Property="Background" Value="#151923"/>
            <Setter Property="Foreground" Value="{StaticResource Text2}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="13,8"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background"
                                        Value="#1D2230"/>
                                <Setter Property="Foreground"
                                        Value="{StaticResource Text}"/>
                                <Setter Property="BorderBrush"
                                        Value="#3A4253"/>
                            </Trigger>

                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- =========================
             COMBO
             ========================= -->

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#151923"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Height" Value="40"/>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Background" Value="#151923"/>
            <Setter Property="Padding" Value="10"/>
        </Style>

        <!-- =========================
             SETTINGS BUTTON
             ========================= -->

        <Style x:Key="SettingsButton" TargetType="Button">
            <Setter Property="Background" Value="#151923"/>
            <Setter Property="Foreground" Value="{StaticResource Text2}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background"
                                        Value="#1D2230"/>
                                <Setter Property="BorderBrush"
                                        Value="#3A4253"/>
                            </Trigger>
                        </ControlTemplate.Triggers>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>


    <Border x:Name="RootBorder"
            Background="{StaticResource Bg}"
            BorderBrush="{StaticResource Border}"
            BorderThickness="1"
            CornerRadius="20"
            MouseLeftButtonDown="Border_MouseLeftButtonDown">

        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="74"/>
                <RowDefinition Height="1"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>


            <!-- =========================================
                 HEADER
                 ========================================= -->

            <Grid Grid.Row="0"
                  Margin="24,0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>


                <StackPanel VerticalAlignment="Center">

                    <StackPanel Orientation="Horizontal">

                        <Border Width="34"
                                Height="34"
                                CornerRadius="10"
                                Background="{StaticResource Accent}"
                                Margin="0,0,10,0">

                            <TextBlock Text="⚖"
                                       FontSize="18"
                                       Foreground="White"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>

                        </Border>

                        <StackPanel>

                            <TextBlock Text="GTA5RP LEGAL HELPER"
                                       Foreground="{StaticResource Text}"
                                       FontSize="15"
                                       FontWeight="Bold"/>

                            <TextBlock Text="Официальный помощник по правилам и законам"
                                       Foreground="{StaticResource Text3}"
                                       FontSize="10"
                                       Margin="0,2,0,0"/>

                        </StackPanel>

                    </StackPanel>

                </StackPanel>


                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">

                    <Border Background="#10251F"
                            BorderBrush="#1C4438"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="9,5"
                            Margin="0,0,8,0">

                        <StackPanel Orientation="Horizontal">

                            <Ellipse Width="7"
                                     Height="7"
                                     Fill="{StaticResource Green}"
                                     Margin="0,0,6,0"/>

                            <TextBlock Text="ONLINE"
                                       Foreground="{StaticResource Green}"
                                       FontSize="9"
                                       FontWeight="Bold"/>

                        </StackPanel>

                    </Border>

                    <Button Content="⚙"
                            Style="{StaticResource IconButton}"
                            Click="SettingsBtn_Click"
                            ToolTip="Настройки"/>

                    <Button Content="×"
                            Style="{StaticResource IconButton}"
                            FontSize="20"
                            Click="CloseBtn_Click"
                            ToolTip="Скрыть"/>

                </StackPanel>

            </Grid>


            <Border Grid.Row="1"
                    Background="{StaticResource Border}"/>


            <!-- =========================================
                 MAIN CONTENT
                 ========================================= -->

            <Grid Grid.Row="2"
                  Margin="28,24,28,18">

                <!-- HOME -->

                <ScrollViewer x:Name="HomeScroll"
                              VerticalScrollBarVisibility="Auto">

                    <StackPanel>

                        <TextBlock Text="Чем могу помочь?"
                                   Foreground="{StaticResource Text}"
                                   FontSize="28"
                                   FontWeight="Bold"/>

                        <TextBlock Text="Найду актуальную информацию прямо в официальной базе GTA5RP."
                                   Foreground="{StaticResource Text2}"
                                   FontSize="13"
                                   Margin="0,7,0,22"/>


                        <!-- SEARCH -->

                        <Border Background="{StaticResource Panel2}"
                                BorderBrush="{StaticResource Border}"
                                BorderThickness="1"
                                CornerRadius="15"
                                Padding="5">

                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="46"/>
                                    <ColumnDefinition Width="46"/>
                                </Grid.ColumnDefinitions>

                                <TextBox x:Name="Question"
                                         Grid.Column="0"
                                         Background="Transparent"
                                         Foreground="{StaticResource Text}"
                                         BorderThickness="0"
                                         FontSize="14"
                                         Padding="13,10"
                                         VerticalContentAlignment="Center"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         KeyDown="Question_KeyDown"/>

                                <Button x:Name="MicBtn"
                                        Grid.Column="1"
                                        Content="🎙"
                                        Style="{StaticResource IconButton}"
                                        Click="MicBtn_Click"
                                        ToolTip="Голосовой ввод — F6"/>

                                <Button x:Name="SendBtn"
                                        Grid.Column="2"
                                        Content="➤"
                                        Style="{StaticResource IconButton}"
                                        Background="{StaticResource Accent}"
                                        Foreground="White"
                                        Click="SendBtn_Click"
                                        ToolTip="Отправить — Enter"/>

                            </Grid>

                        </Border>


                        <!-- STATUS -->

                        <StackPanel Orientation="Horizontal"
                                    Margin="4,8,0,0">

                            <TextBlock x:Name="StatusDot"
                                       Text="●"
                                       Foreground="{StaticResource Green}"
                                       FontSize="8"
                                       VerticalAlignment="Center"/>

                            <TextBlock x:Name="StatusText"
                                       Text="Готов к работе"
                                       Foreground="{StaticResource Text3}"
                                       FontSize="10"
                                       Margin="6,0,0,0"/>

                        </StackPanel>


                        <!-- CONTEXT -->

                        <TextBlock Text="КОНТЕКСТ"
                                   Foreground="{StaticResource Text3}"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Margin="0,24,0,9"/>

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <ComboBox x:Name="ProjectBox"
                                      Grid.Column="0"
                                      Margin="0,0,7,0"
                                      SelectionChanged="ProjectBox_Changed">

                                <ComboBoxItem Content="GTA5RP"
                                              IsSelected="True"/>

                                <ComboBoxItem Content="Majestic RP"/>

                                <ComboBoxItem Content="Russia Online"/>

                            </ComboBox>

                            <ComboBox x:Name="ServerBox"
                                      Grid.Column="1"
                                      Margin="7,0,7,0"/>

                            <ComboBox x:Name="ModeBox"
                                      Grid.Column="2"
                                      Margin="7,0,0,0">

                                <ComboBoxItem Content="Игровые правила"
                                              Tag="rules"
                                              IsSelected="True"/>

                                <ComboBoxItem Content="Законодательная база"
                                              Tag="laws"/>

                            </ComboBox>

                        </Grid>


                        <!-- QUICK ACTIONS -->

                        <TextBlock Text="БЫСТРЫЕ ДЕЙСТВИЯ"
                                   Foreground="{StaticResource Text3}"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Margin="0,27,0,10"/>


                        <Grid>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="100"/>
                                <RowDefinition Height="100"/>
                            </Grid.RowDefinitions>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>


                            <Button Grid.Row="0"
                                    Grid.Column="0"
                                    Margin="0,0,6,6"
                                    Style="{StaticResource QuickActionButton}"
                                    Click="ArticleQuick_Click">

                                <StackPanel>

                                    <TextBlock Text="⚖"
                                               FontSize="20"
                                               Foreground="{StaticResource Accent2}"/>

                                    <TextBlock Text="Найти статью"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Margin="0,8,0,0"/>

                                    <TextBlock Text="УК / ДК / НПА"
                                               Foreground="{StaticResource Text3}"
                                               FontSize="10"
                                               Margin="0,3,0,0"/>

                                </StackPanel>

                            </Button>


                            <Button Grid.Row="0"
                                    Grid.Column="1"
                                    Margin="6,0,0,6"
                                    Style="{StaticResource QuickActionButton}"
                                    Click="RulesQuick_Click">

                                <StackPanel>

                                    <TextBlock Text="📖"
                                               FontSize="20"/>

                                    <TextBlock Text="Правила сервера"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Margin="0,8,0,0"/>

                                    <TextBlock Text="Игровые правила и термины"
                                               Foreground="{StaticResource Text3}"
                                               FontSize="10"
                                               Margin="0,3,0,0"/>

                                </StackPanel>

                            </Button>


                            <Button Grid.Row="1"
                                    Grid.Column="0"
                                    Margin="0,6,6,0"
                                    Style="{StaticResource QuickActionButton}"
                                    Click="TermsQuick_Click">

                                <StackPanel>

                                    <TextBlock Text="🎮"
                                               FontSize="20"/>

                                    <TextBlock Text="Игровые термины"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Margin="0,8,0,0"/>

                                    <TextBlock Text="DB · DM · MG · PG · RK"
                                               Foreground="{StaticResource Text3}"
                                               FontSize="10"
                                               Margin="0,3,0,0"/>

                                </StackPanel>

                            </Button>


                            <Button Grid.Row="1"
                                    Grid.Column="1"
                                    Margin="6,6,0,0"
                                    Style="{StaticResource QuickActionButton}"
                                    Click="HistoryQuick_Click">

                                <StackPanel>

                                    <TextBlock Text="🕘"
                                               FontSize="20"/>

                                    <TextBlock Text="История запросов"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Margin="0,8,0,0"/>

                                    <TextBlock Text="Последние вопросы"
                                               Foreground="{StaticResource Text3}"
                                               FontSize="10"
                                               Margin="0,3,0,0"/>

                                </StackPanel>

                            </Button>

                        </Grid>


                        <!-- POPULAR -->

                        <TextBlock Text="ПОПУЛЯРНОЕ"
                                   Foreground="{StaticResource Text3}"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Margin="0,25,0,10"/>

                        <WrapPanel>

                            <Button Content="17.1 УК"
                                    Style="{StaticResource ChipButton}"
                                    Click="Popular_Click"/>

                            <Button Content="DB"
                                    Style="{StaticResource ChipButton}"
                                    Click="Popular_Click"/>

                            <Button Content="DM"
                                    Style="{StaticResource ChipButton}"
                                    Click="Popular_Click"/>

                            <Button Content="MG"
                                    Style="{StaticResource ChipButton}"
                                    Click="Popular_Click"/>

                            <Button Content="PG"
                                    Style="{StaticResource ChipButton}"
                                    Click="Popular_Click"/>

                            <Button Content="RK"
                                    Style="{StaticResource ChipButton}"
                                    Click="Popular_Click"/>

                        </WrapPanel>

                    </StackPanel>

                </ScrollViewer>


                <!-- ANSWER -->

                <Grid x:Name="AnswerView"
                      Visibility="Collapsed">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>


                    <StackPanel Grid.Row="0"
                                Orientation="Horizontal"
                                Margin="0,0,0,16">

                        <Button Content="←"
                                Style="{StaticResource IconButton}"
                                Click="BackHome_Click"
                                Margin="0,0,10,0"/>

                        <StackPanel VerticalAlignment="Center">

                            <TextBlock Text="РЕЗУЛЬТАТ"
                                       Foreground="{StaticResource Text3}"
                                       FontSize="9"
                                       FontWeight="Bold"/>

                            <TextBlock Text="Найдено в официальной базе"
                                       Foreground="{StaticResource Text2}"
                                       FontSize="11"/>

                        </StackPanel>

                    </StackPanel>


                    <ScrollViewer Grid.Row="1"
                                  x:Name="AnswerScroll"
                                  VerticalScrollBarVisibility="Auto">

                        <StackPanel>

                            <Border Background="{StaticResource Panel2}"
                                    BorderBrush="{StaticResource Border}"
                                    BorderThickness="1"
                                    CornerRadius="16"
                                    Padding="24">

                                <StackPanel>

                                    <TextBlock x:Name="AnswerTitle"
                                               Text="Ответ"
                                               Foreground="{StaticResource Text}"
                                               FontSize="24"
                                               FontWeight="Bold"
                                               TextWrapping="Wrap"/>

                                    <TextBlock x:Name="AnswerSubtitle"
                                               Foreground="{StaticResource Text2}"
                                               FontSize="14"
                                               TextWrapping="Wrap"
                                               Margin="0,7,0,20"/>


                                    <Border x:Name="PenaltyCard"
                                            Background="#171C27"
                                            BorderBrush="#30384A"
                                            BorderThickness="1"
                                            CornerRadius="13"
                                            Padding="18"
                                            Visibility="Collapsed"
                                            Margin="0,0,0,20">

                                        <StackPanel>

                                            <TextBlock Text="НАКАЗАНИЕ"
                                                       Foreground="{StaticResource Text3}"
                                                       FontSize="9"
                                                       FontWeight="Bold"/>

                                            <TextBlock x:Name="PenaltyText"
                                                       Foreground="{StaticResource Text}"
                                                       FontSize="24"
                                                       FontWeight="Bold"
                                                       Margin="0,6,0,0"/>

                                        </StackPanel>

                                    </Border>


                                    <TextBlock Text="КРАТКО"
                                               Foreground="{StaticResource Text3}"
                                               FontSize="9"
                                               FontWeight="Bold"/>

                                    <TextBlock x:Name="Answer"
                                               Foreground="{StaticResource Text2}"
                                               FontSize="14"
                                               TextWrapping="Wrap"
                                               LineHeight="22"
                                               Margin="0,8,0,22"/>


                                    <Border Background="#0E1117"
                                            CornerRadius="11"
                                            Padding="14">

                                        <StackPanel>

                                            <TextBlock Text="ИСТОЧНИК"
                                                       Foreground="{StaticResource Text3}"
                                                       FontSize="9"
                                                       FontWeight="Bold"/>

                                            <TextBlock x:Name="SourceText"
                                                       Foreground="{StaticResource Text2}"
                                                       FontSize="11"
                                                       TextWrapping="Wrap"
                                                       Margin="0,5,0,0"/>

                                        </StackPanel>

                                    </Border>

                                </StackPanel>

                            </Border>

                        </StackPanel>

                    </ScrollViewer>

                </Grid>


                <!-- SETTINGS -->

                <Border x:Name="SettingsPanel"
                        Visibility="Collapsed"
                        Background="{StaticResource Panel}"
                        BorderBrush="{StaticResource Border}"
                        BorderThickness="1"
                        CornerRadius="16"
                        Padding="22">

                    <ScrollViewer VerticalScrollBarVisibility="Auto">

                        <StackPanel>

                            <TextBlock Text="Настройки"
                                       Foreground="{StaticResource Text}"
                                       FontSize="24"
                                       FontWeight="Bold"/>

                            <TextBlock Text="Персонализируй Legal Helper под себя."
                                       Foreground="{StaticResource Text2}"
                                       FontSize="12"
                                       Margin="0,5,0,24"/>


                            <TextBlock Text="ВНЕШНИЙ ВИД"
                                       Foreground="{StaticResource Text3}"
                                       FontSize="9"
                                       FontWeight="Bold"/>

                            <TextBlock Text="Прозрачность"
                                       Foreground="{StaticResource Text}"
                                       FontSize="12"
                                       Margin="0,12,0,5"/>

                            <Slider x:Name="OpacitySlider"
                                    Minimum="0.45"
                                    Maximum="1"
                                    Value="0.94"
                                    TickFrequency="0.05"
                                    IsSnapToTickEnabled="True"
                                    ValueChanged="OpacitySlider_Changed"/>

                            <TextBlock x:Name="OpacityLabel"
                                       Text="94%"
                                       Foreground="{StaticResource Text3}"
                                       FontSize="10"
                                       Margin="0,4,0,18"/>


                            <TextBlock Text="РАЗМЕР"
                                       Foreground="{StaticResource Text3}"
                                       FontSize="9"
                                       FontWeight="Bold"/>

                            <StackPanel Orientation="Horizontal"
                                        Margin="0,10,0,20">

                                <Button Content="−"
                                        Style="{StaticResource SettingsButton}"
                                        Click="SizeDown_Click"
                                        Margin="0,0,6,0"/>

                                <Button Content="+"
                                        Style="{StaticResource SettingsButton}"
                                        Click="SizeUp_Click"
                                        Margin="0,0,6,0"/>

                                <Button Content="Сбросить"
                                        Style="{StaticResource SettingsButton}"
                                        Click="SizeReset_Click"/>

                            </StackPanel>


                            <TextBlock Text="УПРАВЛЕНИЕ"
                                       Foreground="{StaticResource Text3}"
                                       FontSize="9"
                                       FontWeight="Bold"/>


                            <Grid Margin="0,12,0,8">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="120"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel>

                                    <TextBlock Text="Оверлей"
                                               Foreground="{StaticResource Text}"
                                               FontSize="12"/>

                                    <TextBlock Text="Включение / выключение"
                                               Foreground="{StaticResource Text3}"
                                               FontSize="10"/>

                                </StackPanel>

                                <Button x:Name="ToggleBindBtn"
                                        Grid.Column="1"
                                        Content="F5"
                                        Style="{StaticResource SettingsButton}"
                                        Click="ToggleBindBtn_Click"/>

                            </Grid>


                            <Grid Margin="0,0,0,12">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="120"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel>

                                    <TextBlock Text="Микрофон"
                                               Foreground="{StaticResource Text}"
                                               FontSize="12"/>

                                    <TextBlock Text="Голосовой ввод"
                                               Foreground="{StaticResource Text3}"
                                               FontSize="10"/>

                                </StackPanel>

                                <Button x:Name="MicBindBtn"
                                        Grid.Column="1"
                                        Content="F6"
                                        Style="{StaticResource SettingsButton}"
                                        Click="MicBindBtn_Click"/>

                            </Grid>


                            <TextBlock x:Name="BindCaptureHint"
                                       Foreground="{StaticResource Yellow}"
                                       FontSize="10"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,15"/>


                            <CheckBox x:Name="ClickThroughBox"
                                      Content="Клик насквозь"
                                      Foreground="{StaticResource Text}"
                                      Margin="0,0,0,20"/>


                            <TextBlock Text="ИСТОРИЯ"
                                       Foreground="{StaticResource Text3}"
                                       FontSize="9"
                                       FontWeight="Bold"/>

                            <ListBox x:Name="HistoryList"
                                     MaxHeight="150"
                                     Background="{StaticResource Panel2}"
                                     Foreground="{StaticResource Text}"
                                     BorderThickness="0"
                                     Margin="0,10,0,18"
                                     MouseDoubleClick="HistoryList_DoubleClick"/>


                            <StackPanel Orientation="Horizontal">

                                <Button Content="Сохранить"
                                        Background="{StaticResource Accent}"
                                        Foreground="White"
                                        BorderThickness="0"
                                        Padding="16,9"
                                        Cursor="Hand"
                                        Click="SaveSettings_Click"
                                        Margin="0,0,8,0"/>

                                <Button Content="Сбросить бинды"
                                        Style="{StaticResource SettingsButton}"
                                        Click="ResetBinds_Click"
                                        Margin="0,0,8,0"/>

                                <Button Content="Назад"
                                        Style="{StaticResource SettingsButton}"
                                        Click="SettingsBtn_Click"/>

                            </StackPanel>


                            <TextBlock x:Name="VersionLabel"
                                       Foreground="{StaticResource Text3}"
                                       FontSize="10"
                                       Margin="0,20,0,0"/>

                            <TextBlock x:Name="UpdateLabel"
                                       Foreground="{StaticResource Green}"
                                       FontSize="10"
                                       TextWrapping="Wrap"
                                       Margin="0,5,0,0"/>

                        </StackPanel>

                    </ScrollViewer>

                </Border>

            </Grid>


            <!-- =========================================
                 FOOTER
                 ========================================= -->

            <Border Grid.Row="3"
                    Background="#0E1117"
                    BorderBrush="{StaticResource Border}"
                    BorderThickness="0,1,0,0"
                    Padding="24,12">

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>


                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center">

                        <Border Background="#171C27"
                                CornerRadius="7"
                                Padding="7,4"
                                Margin="0,0,7,0">

                            <TextBlock Text="F5"
                                       Foreground="{StaticResource Text2}"
                                       FontSize="9"
                                       FontWeight="Bold"/>

                        </Border>

                        <TextBlock Text="Оверлей"
                                   Foreground="{StaticResource Text3}"
                                   FontSize="10"
                                   VerticalAlignment="Center"
                                   Margin="0,0,15,0"/>


                        <Border Background="#171C27"
                                CornerRadius="7"
                                Padding="7,4"
                                Margin="0,0,7,0">

                            <TextBlock Text="F6"
                                       Foreground="{StaticResource Text2}"
                                       FontSize="9"
                                       FontWeight="Bold"/>

                        </Border>

                        <TextBlock x:Name="MicFooterText"
                                   Text="Микрофон"
                                   Foreground="{StaticResource Text3}"
                                   FontSize="10"
                                   VerticalAlignment="Center"/>

                    </StackPanel>


                    <TextBlock Grid.Column="1"
                               Text="Shift + Enter — новая строка"
                               Foreground="{StaticResource Text3}"
